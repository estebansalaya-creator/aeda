    // aplicación": la clave normal de la cuenta no sirve.
    'SMTP_HOST'     => 'smtp.gmail.com',
    'SMTP_PORT'     => '465',         // 465 con SSL, o 587 con STARTTLS
    'SMTP_USER'     => '',            // la casilla que envía, con @
    'SMTP_PASS'     => '',            // contraseña de aplicación, sin espacios
    'SMTP_DESDE'    => '',            // por defecto, igual que SMTP_USER
    'SMTP_NOMBRE'   => 'AEDA',
    'SMTP_COPIA'    => '',            // copia oculta al organizador

    // ── Reporte diario (reporte.php) ────────────────────────────────────
